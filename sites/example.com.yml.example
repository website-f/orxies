# Per-site config. Drop one of these in /opt/orxies/orxies/sites/
# (rename to <domain>.yml — the .example suffix is what stops orxies
# from picking up this file). Hot-reloaded on save.

domain: example.com
aliases:
  - www.example.com
upstreams:
  - 127.0.0.1:8082          # add more lines for load balancing
enabled: true
tls:
  auto: true                # request Let's Encrypt cert automatically
http_to_https: true
websocket: true
block_common_exploits: true
rate_limit:
  enabled: false
  rps: 30
  burst: 60
custom_headers:
  Strict-Transport-Security: "max-age=31536000; includeSubDomains"
  X-Frame-Options: "DENY"
  X-Content-Type-Options: "nosniff"

# ── Static site variant ──────────────────────────────────────────────
# To serve raw HTML / a portfolio / a Next.js or Vite static export with
# NO sidecar server: drop the built files in orxies's www/<name>/ and
# set `root` instead of `upstreams`. Everything else (TLS, rate limit,
# exploit blocking, custom headers) works the same.
#
#   domain: portfolio.example.com
#   root: portfolio        # -> serves www/portfolio/ (or an absolute path)
#   spa: false             # true = serve index.html for unmatched paths
#   enabled: true          #        (React/Vue routers, static exports)
#   tls:
#     auto: true
#   http_to_https: true
#   block_common_exploits: true
